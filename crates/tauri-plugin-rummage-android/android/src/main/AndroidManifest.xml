<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 读取被索引的文件（“所有文件访问”），由用户在系统设置中授予 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 后台建立索引的前台服务（IndexService）与常驻通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Android 14 上没有 mediaProcessing 类型，改用 dataSync（见 IndexService） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 请用户允许不受电池优化限制 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内更新：用 PackageInstaller 会话安装下载的 APK（ApkInstaller） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <service
            android:name="com.cooksleep.rummage.storage.IndexService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />
    </application>
</manifest>
