{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rummage",
  "version": "../package.json",
  "identifier": "com.cooksleep.rummage",
  "build": {
    "beforeDevCommand": "node scripts/build-core.mjs && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/build-core.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rummage",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: http://media.localhost",
        "media-src": "http://media.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMkM3N0VFRTNCMTY5QzgKUldUSWFiSGo3bmNzVEU2NTlBdHpWZGQ5SmZlVU1JTXlGUWRTTTVEeW9pOENyQnVJdjNubFpTVXUK",
      "endpoints": ["https://github.com/CookSleep/Rummage/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "template": "windows/installer.nsi"
      }
    }
  }
}
